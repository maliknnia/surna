# =============================================================================
# SURNA — environment template
# Copy to `.env` and fill in values. Never commit `.env` with real secrets.
# =============================================================================
#
# Quick start (local dev):
#   cp .env.example .env
#   Set DATABASE_URL, SESSION_SECRET, JWT_SECRET
#   LOCAL_AUTH_BYPASS=1  PRO_ENTITLEMENT_OPEN=1
#   npm run dev
#
# Production minimum:
#   DATABASE_URL, SESSION_SECRET (32+ chars), JWT_SECRET (32+ chars),
#   FRONTEND_ORIGIN, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
#   CLOUDINARY_* (enough for photos + videos on free tier), REDIS_URL (optional)
#   S3_* (optional — only if you outgrow Cloudinary or want self-hosted storage)
#   LOCAL_AUTH_BYPASS=0  PRO_ENTITLEMENT_OPEN=0
# =============================================================================


# =========================
# Client (Vite — exposed to browser; prefix VITE_)
# =========================

# Stripe publishable key (checkout, marketplace, Pro tournament)
VITE_STRIPE_PUBLIC_KEY=

# Stripe Price ID for SURNA Pro subscription
VITE_STRIPE_PRO_PRICE_ID=

# Web Push VAPID public key (Settings → notifications)
VITE_VAPID_PUBLIC_KEY=

# Google Analytics 4 measurement ID
VITE_GA_MEASUREMENT_ID=

# Giphy API key (camera GIF picker, messenger)
VITE_GIPHY_API_KEY=

# MapTiler API key (map tiles)
VITE_MAPTILER_KEY=

# 3D trees: lite (default) | full | off — lite = parks only, zoom 17+, max 25 trees
VITE_MAP_3D_TREES=

# Optional GLB for custom tree model (lite/full modes)
VITE_MAP_TREE_MODEL=

# Show messenger demo threads when inbox is empty (true/false; omit = auto in dev)
VITE_MESSENGER_DEMOS=

# Showcase map pins when viewport is empty (true/false; omit = auto in dev, off in prod)
VITE_MAP_DEMO_PINS=

# Demo rows when public lists are empty — home, events, teams, places, coaches, stories (true/false; omit = auto in dev)
VITE_DEMO_FALLBACK=

# Dev-only: bypass Pro paywall on client (mirror with PRO_ENTITLEMENT_OPEN server-side)
VITE_PRO_ENTITLEMENT_OPEN=0

# Vite dev-server proxy target when running client separately (default http://127.0.0.1:5000)
VITE_API_PROXY=http://127.0.0.1:5000

# Built-in Vite vars (do not set manually): DEV, PROD, MODE, BASE_URL


# =========================
# Core runtime
# =========================

NODE_ENV=development
PORT=5000

# Public app URL for links in emails/referrals (no trailing slash)
BASE_URL=https://surna.app

# Comma-separated CORS origins for credentialed API calls (required in production)
FRONTEND_ORIGIN=http://localhost:5000,http://localhost:5173

# Session cookie signing secret (32+ random chars; required in production)
SESSION_SECRET=

# Primary JWT secret (API + realtime; 32+ chars; required in production)
JWT_SECRET=


# =========================
# Auth / identity
# =========================

# Local email/phone login without Replit OIDC (development only — must be 0 in production)
LOCAL_AUTH_BYPASS=1

# Seed/find dev user when LOCAL_AUTH_BYPASS=1
LOCAL_DEV_USER_EMAIL=dev@surna.local

# Replit OIDC (optional; legacy hosting)
REPL_ID=
REPLIT_DOMAINS=localhost
USE_REPLIT_AUTH=0

# Google OAuth (optional; /api/auth/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phone OTP — dev bypass code when PHONE_OTP_DEV=1 or non-production
PHONE_OTP_DEV=1
DEV_PHONE_OTP=123456

# JWT access/refresh token secrets (preferred over JWT_SECRET for auth module)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Let any signed-in user access /pro (also true when LOCAL_AUTH_BYPASS=1 or NODE_ENV≠production)
PRO_ENTITLEMENT_OPEN=1


# =========================
# Database / cache
# =========================

DATABASE_URL=
DATABASE_REPLICA_URL=

REDIS_URL=

DB_POOL_MAX=10
DB_POOL_MAX_REPLICA=10
DB_POOL_MIN=5
DB_POOL_IDLE_MS=30000
DB_POOL_IDLE=10000
DB_POOL_ACQUIRE=30000
DB_POOL_CONN_TIMEOUT_MS=10000


# =========================
# Security / encryption
# =========================

# Field-level PII encryption (hex; required for production PII encryption)
FIELD_ENC_KEY_HEX=

# Optional master key + salt for dataEncryption module (hex); temp keys generated if unset
ENCRYPTION_MASTER_KEY=
ENCRYPTION_SALT=

# Legacy 2FA backup encryption (prefer FIELD_ENC_KEY_HEX)
ENCRYPTION_KEY=

# HMAC for signed media/download URLs
SIGNED_URL_SECRET=

LOG_LEVEL=info


# =========================
# Payments (Stripe)
# =========================

STRIPE_SECRET_KEY=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Marketplace tax rate in basis points (850 = 8.5%)
TAX_RATE_BPS=0

# Default marketplace currency code
CURRENCY_DEFAULT=USD
MARKETPLACE_PAGE_SIZE=20


# =========================
# Cloudinary (photos + videos — free tier is enough to start)
# =========================

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# =========================
# Storage / media (S3-compatible — optional if Cloudinary is set)
# =========================

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

MEDIA_CACHE_CONTROL=public, max-age=31536000, immutable
MEDIA_DISABLE_AVIF=0
UPLOAD_MAX_MB=15
MEDIA_JOB_ATTEMPTS=4
MEDIA_JOB_BACKOFF_MS=2000

# Max video upload size for S3 presigned uploads (MB). Feed/camera video uses Cloudinary (200MB server limit).
VIDEO_MAX_MB=100


# Server-side Google Maps/Geocoding (optional; Nominatim fallback if unset)
GOOGLE_MAPS_API_KEY=


# =========================
# Email / SMS / push
# =========================

SENDGRID_API_KEY=
FROM_EMAIL=noreply@surna.app
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Web Push (server)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@surna.app
VAPID_EMAIL=admin@surna.app

# Twilio SMS MFA (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=


# =========================
# AI (optional)
# =========================

ANTHROPIC_API_KEY=


# =========================
# Webhooks / integrations
# =========================

FACEBOOK_WEBHOOK_SECRET=
CUSTOM_WEBHOOK_SECRET=

# Sentry (commented in code; optional)
SENTRY_DSN=


# =========================
# CDN purge (optional)
# =========================

CDN_PROVIDER=none
CDN_PURGE_ENDPOINT=
CDN_PURGE_TOKEN=
CDN_ZONE_ID=


# =========================
# Alerting / monitoring
# =========================

HEALTH_ALERT_POLL_MS=60000
ALERT_WEBHOOK_MIN_INTERVAL_SECONDS=600
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=slack
ALERT_SOURCE_NAME=surna-api
PAGERDUTY_ROUTING_KEY=
BETTER_STACK_HEARTBEAT_URL=


# =========================
# Rate limiting / SLO
# =========================

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
SLO_QUEUE_BACKLOG_MAX=1000
SLO_HEARTBEAT_MAX_AGE_SEC=180
SLO_P95_LATENCY_MS=500
SLO_ERROR_RATE_PERCENT=1
SLO_DB_POOL_UTIL_PERCENT=80


# =========================
# Platform / keep-alive (Railway, Neon, Render)
# =========================

# Override self-ping URL (default: public URL or http://127.0.0.1:PORT/api/ping)
KEEP_ALIVE_URL=
RAILWAY_PUBLIC_DOMAIN=
RENDER_EXTERNAL_URL=
PUBLIC_APP_URL=


# =========================
# Feature flags
# =========================

# Auto-verify coach applications on submit
COACH_AUTO_VERIFY=0


# =========================
# Scripts / CI / load testing
# =========================

LOADTEST_USER_ID=loadtest-user
LOADTEST_USERNAME=loadtest
LOADTEST_TOKEN_TTL=2h

# Playwright CI (set by CI runners)
CI=

LOADTEST_TOKEN_TTL=2h
LOADTEST_TOKEN_TTL=2h